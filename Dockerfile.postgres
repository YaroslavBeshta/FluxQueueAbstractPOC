FROM postgres:14

# Install Python and pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt

# Copy pyproject.toml for package installation
COPY pyproject.toml /app/pyproject.toml

# Copy application code needed for migrations
COPY packages/ /app/packages/
RUN pip3 install --break-system-packages -e /app

# Copy apps and alembic config
COPY apps/ /app/apps/
COPY alembic.ini /app/alembic.ini

# Set Python path
ENV PYTHONPATH=/app

# Copy the postgres entrypoint script
COPY postgres-entrypoint.sh /usr/local/bin/postgres-entrypoint.sh
RUN chmod +x /usr/local/bin/postgres-entrypoint.sh

# Use our custom entrypoint
ENTRYPOINT ["/usr/local/bin/postgres-entrypoint.sh"]
CMD ["postgres"]

